# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost:3000

# Storage (relative to backend/)
STORAGE_ROOT=storage

# Transcription (Faster-Whisper)
TRANSCRIPTION_BACKEND=faster_whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
WHISPER_WORD_TIMESTAMPS=false
# WHISPER_INITIAL_PROMPT=
TRANSCRIPT_TIMELINE_BLOCK_SECONDS=30

# Scene segmentation
SEGMENTATION_BACKEND=auto
SEGMENTATION_SEMANTIC_GROUPING=true
SCENE_MIN_DURATION_SECONDS=3
SCENE_MAX_DURATION_SECONDS=90
SCENE_TARGET_DURATION_SECONDS=15

# LLM segmentation (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_ENABLED=true

# Optional Gemini (set GEMINI_ENABLED=true and GEMINI_API_KEY)
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Video output
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30

# Cinematic subtitles (ratios scale with resolution)
SUBTITLE_ENABLED=true
SUBTITLE_THEME=cinematic
SUBTITLE_POSITION=bottom
SUBTITLE_MARGIN_RATIO=0.075
SUBTITLE_MAX_WIDTH_RATIO=0.85
SUBTITLE_FONT_SIZE_RATIO=0.042
SUBTITLE_LINE_SPACING_RATIO=0.35
SUBTITLE_ANIMATION=fade
SUBTITLE_ANIMATION_SECONDS=0.22
# SUBTITLE_FONT_PATH=
