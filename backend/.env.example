# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost:3000

# Storage (relative to backend/)
STORAGE_ROOT=storage

# Transcription (Faster-Whisper)
TRANSCRIPTION_BACKEND=faster_whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
WHISPER_WORD_TIMESTAMPS=false
# WHISPER_INITIAL_PROMPT=
TRANSCRIPT_TIMELINE_BLOCK_SECONDS=30

# LLM segmentation (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_ENABLED=true

# Optional Gemini (set GEMINI_ENABLED=true and GEMINI_API_KEY)
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Video output
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
